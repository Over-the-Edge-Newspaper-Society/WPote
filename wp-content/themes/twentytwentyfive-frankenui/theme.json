{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Twenty Twenty-Five Franken UI",
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"palette": [
				{
					"slug": "primary",
					"color": "hsl(0, 0%, 9%)",
					"name": "Primary"
				},
				{
					"slug": "primary-foreground",
					"color": "hsl(0, 0%, 98%)",
					"name": "Primary Foreground"
				},
				{
					"slug": "secondary",
					"color": "hsl(0, 0%, 96%)",
					"name": "Secondary"
				},
				{
					"slug": "secondary-foreground",
					"color": "hsl(0, 0%, 9%)",
					"name": "Secondary Foreground"
				},
				{
					"slug": "background",
					"color": "hsl(0, 0%, 100%)",
					"name": "Background"
				},
				{
					"slug": "foreground",
					"color": "hsl(0, 0%, 4%)",
					"name": "Foreground"
				},
				{
					"slug": "muted",
					"color": "hsl(0, 0%, 96%)",
					"name": "Muted"
				},
				{
					"slug": "muted-foreground",
					"color": "hsl(0, 0%, 45%)",
					"name": "Muted Foreground"
				},
				{
					"slug": "accent",
					"color": "hsl(0, 0%, 96%)",
					"name": "Accent"
				},
				{
					"slug": "accent-foreground",
					"color": "hsl(0, 0%, 9%)",
					"name": "Accent Foreground"
				},
				{
					"slug": "destructive",
					"color": "hsl(357, 100%, 45%)",
					"name": "Destructive"
				},
				{
					"slug": "destructive-foreground",
					"color": "hsl(0, 0%, 100%)",
					"name": "Destructive Foreground"
				},
				{
					"slug": "border",
					"color": "hsl(0, 0%, 90%)",
					"name": "Border"
				}
			]
		},
		"typography": {
			"fluid": true,
			"fontFamilies": [
				{
					"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
					"name": "System Font",
					"slug": "system-font"
				},
				{
					"fontFamily": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
					"name": "Inter",
					"slug": "inter",
					"fontFace": [
						{
							"fontFamily": "Inter",
							"fontWeight": "100 900",
							"fontStyle": "normal",
							"fontStretch": "normal",
							"src": ["https://fonts.bunny.net/inter/files/inter-latin-variable-full-normal.woff2"]
						}
					]
				}
			],
			"fontSizes": [
				{
					"size": "0.75rem",
					"slug": "small",
					"name": "Small"
				},
				{
					"size": "0.875rem",
					"slug": "medium",
					"name": "Medium"
				},
				{
					"size": "1rem",
					"slug": "large",
					"name": "Large"
				},
				{
					"size": "1.125rem",
					"slug": "x-large",
					"name": "Extra Large"
				},
				{
					"size": "1.5rem",
					"slug": "xx-large",
					"name": "2X Large"
				},
				{
					"size": "2rem",
					"slug": "xxx-large",
					"name": "3X Large"
				},
				{
					"size": "3rem",
					"slug": "xxxx-large",
					"name": "4X Large"
				}
			]
		},
		"spacing": {
			"units": ["px", "em", "rem", "%", "vw", "vh"],
			"padding": true,
			"margin": true,
			"blockGap": true
		},
		"layout": {
			"contentSize": "720px",
			"wideSize": "1200px"
		},
		"blocks": {
			"core/button": {
				"border": {
					"radius": true
				}
			},
			"core/group": {
				"spacing": {
					"padding": true,
					"margin": true
				}
			},
			"core/columns": {
				"spacing": {
					"padding": true,
					"margin": true,
					"blockGap": true
				}
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--background)",
			"text": "var(--wp--preset--color--foreground)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--inter)",
			"fontSize": "1rem",
			"lineHeight": "1.6"
		},
		"spacing": {
			"blockGap": "1.5rem",
			"padding": {
				"top": "0",
				"right": "1rem",
				"bottom": "0",
				"left": "1rem"
			}
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--primary)"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--primary-foreground)"
				},
				"typography": {
					"fontSize": "0.875rem",
					"fontWeight": "500"
				},
				"spacing": {
					"padding": {
						"top": "0.5rem",
						"right": "1rem",
						"bottom": "0.5rem",
						"left": "1rem"
					}
				},
				"border": {
					"radius": "0.375rem"
				}
			},
			"heading": {
				"typography": {
					"fontWeight": "700",
					"lineHeight": "1.2"
				},
				"spacing": {
					"margin": {
						"top": "0",
						"bottom": "1rem"
					}
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xxxx-large)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xxx-large)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)"
				}
			}
		},
		"blocks": {
			"core/navigation": {
				"spacing": {
					"blockGap": "2rem"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--foreground)"
						},
						"spacing": {
							"padding": {
								"top": "0.5rem",
								"right": "1rem",
								"bottom": "0.5rem",
								"left": "1rem"
							}
						},
						"border": {
							"radius": "0.375rem"
						},
						":hover": {
							"color": {
								"background": "var(--wp--preset--color--accent)",
								"text": "var(--wp--preset--color--accent-foreground)"
							}
						}
					}
				}
			},
			"core/post-title": {
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--foreground)"
						},
						":hover": {
							"color": {
								"text": "var(--wp--preset--color--primary)"
							}
						}
					}
				}
			},
			"core/post-date": {
				"color": {
					"text": "var(--wp--preset--color--muted-foreground)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)"
				}
			},
			"core/post-author": {
				"color": {
					"text": "var(--wp--preset--color--muted-foreground)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)"
				}
			},
			"core/post-terms": {
				"color": {
					"text": "var(--wp--preset--color--muted-foreground)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)"
				}
			},
			"core/query": {
				"spacing": {
					"margin": {
						"top": "2rem"
					}
				}
			},
			"core/post-template": {
				"spacing": {
					"blockGap": "2rem"
				}
			},
			"core/post": {
				"color": {
					"background": "var(--wp--preset--color--background)"
				},
				"border": {
					"color": "var(--wp--preset--color--border)",
					"width": "1px",
					"style": "solid",
					"radius": "0.5rem"
				},
				"spacing": {
					"padding": {
						"top": "1.5rem",
						"right": "1.5rem",
						"bottom": "1.5rem",
						"left": "1.5rem"
					}
				}
			},
			"core/button": {
				"border": {
					"radius": "0.375rem"
				},
				"variations": {
					"outline": {
						"border": {
							"width": "1px"
						}
					}
				}
			},
			"core/search": {
				"border": {
					"radius": "0.375rem",
					"color": "var(--wp--preset--color--border)"
				}
			},
			"core/tag-cloud": {
				"elements": {
					"link": {
						"color": {
							"background": "var(--wp--preset--color--secondary)",
							"text": "var(--wp--preset--color--secondary-foreground)"
						},
						"spacing": {
							"padding": {
								"top": "0.25rem",
								"right": "0.75rem",
								"bottom": "0.25rem",
								"left": "0.75rem"
							}
						},
						"border": {
							"radius": "0.375rem"
						},
						":hover": {
							"color": {
								"background": "var(--wp--preset--color--primary)",
								"text": "var(--wp--preset--color--primary-foreground)"
							}
						}
					}
				}
			}
		}
	}
}